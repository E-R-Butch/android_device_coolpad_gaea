# 3917JR / gaea —— 系统侧属性（数值取自原厂 getprop 实测，2026-10-17）
ro.sf.lcd_density=480
ro.hardware.vulkan=adreno
qemu.hw.mainkeys=0

# VNDK 兼容性：酷派原厂 Vendor 停留在 API 29 (Android 10)
ro.vndk.version=29

# USB 与调试
sys.usb.controller=a600000.dwc3
vendor.usb.controller=a600000.dwc3
persist.sys.usb.config=adb
sys.usb.config=adb
persist.sys.disable_rescue=true
ro.logd.kernel=true
ro.logd.auditd=true
ro.apex.updatable=false
# ro.adb.secure=0  # PixelOS common sets 1

# Device identification
bluetooth.device.default_name=Coolpad 3917JR

# Camera: Expose all 4 physical rear auxiliary cameras (Main, Wide, Tele, Macro)
persist.vendor.camera.expose.aux=1
# 辅助镜头（0.5x 超广角 / 2.2x 长焦）的可用 App 白名单。
# 本设备用预装的 GCam（org.codeaurora.snapcam）作为唯一相机，列进来让它能枚举 aux 镜头。
# Aperture / Camera2 已从系统移除，不用再列。
# 注意：属性值上限 91 字节（PROP_VALUE_MAX 92 含结尾 NUL），超了构建直接失败。
vendor.camera.aux.packagelist=org.codeaurora.snapcam,com.google.android.GoogleCamera
