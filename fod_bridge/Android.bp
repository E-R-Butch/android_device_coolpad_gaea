cc_binary {
    name: "gaea_fod_bridge",
    srcs: ["gaea_fod_bridge.cpp"],
    init_rc: ["gaea_fod_bridge.rc"],
    shared_libs: [
        "libhidlbase",
        "libutils",
        "liblog",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
    ],
}
